# Any virtualenv name, not just `.venv`. Python's venv writes its own self-ignoring
# .gitignore, but that only helps for venvs created by that module.
.venv*/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
pytest-cache-files-*/
.DS_Store
.tmp/
# Any SQLite artefact. `aether_audit.db` alone left local_audit.db, manual-test.db and
# every ad-hoc AETHER_AUDIT_DB_PATH showing up as untracked. Nothing tracked is a .db.
*.db
*.log

# Frontend
frontend/node_modules/
frontend/out/
frontend/.next/

# Working notes. Kept locally, not published: these are the audit trail of how the
# repo got here, not documentation anyone cloning it needs.
ARCHITECTURE.md
CHANGES.md
HANDOFF.md
RUNNING.md
CODE_TOUR.md
frontend/AGENTS.md
frontend/CLAUDE.md
frontend/README.md

# The operator console has one home: dashboard/. `npm run build` copies it into
# frontend/public so the static export carries it. Two tracked copies drift.
frontend/public/app.js
frontend/public/console.html
frontend/public/styles.css
